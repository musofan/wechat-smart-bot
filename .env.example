# WeChatFerry Configuration
WECHAT_ACCOUNT_WXID=your_wxid_here

# Monitoring Account (the account to forward messages to)
MONITOR_ACCOUNT_NAME=监控账户的微信备注名或昵称

# SenseNova LLM Configuration
SENSENOVA_API_KEY=your_api_key_here
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_MODEL=sense-chat

# Bot Settings
BOT_NAME=你的微信昵称
MAX_CONTEXT_ROUNDS=10
REPLY_DELAY_MIN=1
REPLY_DELAY_MAX=3

# Critical Keywords (comma-separated)
CRITICAL_KEYWORDS=投诉,退款,赔偿,法律,律师,合同终止,重大问题
